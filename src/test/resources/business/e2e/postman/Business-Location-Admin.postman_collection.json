{
  "info": {
    "_postman_id": "0c3a2766-51dc-47a6-9d12-cdb8a0f17d1a",
    "name": "Business Location Admin Flow",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Admin Login",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"usernameOrEmail\": \"{{admin_username}}\",\n  \"password\": \"{{admin_password}}\"\n}"
        },
        "url": "{{base_url}}/api/auth/login"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.response.to.have.status(200);",
              "pm.environment.set('admin_token', pm.response.json().accessToken);"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "2. Create Province",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{admin_token}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Bagmati {{$timestamp}}\"\n}"
        },
        "url": "{{base_url}}/api/v1/admin/business-locations/provinces"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.response.to.have.status(201);",
              "pm.environment.set('province_id', pm.response.json().id);"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "3. Create District",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{admin_token}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"provinceId\": {{province_id}},\n  \"name\": \"Kathmandu {{$timestamp}}\"\n}"
        },
        "url": "{{base_url}}/api/v1/admin/business-locations/districts"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.response.to.have.status(201);",
              "pm.environment.set('district_id', pm.response.json().id);"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "4. Create Municipality",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{admin_token}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"districtId\": {{district_id}},\n  \"name\": \"Kathmandu Metropolitan {{$timestamp}}\",\n  \"type\": \"metropolitan\"\n}"
        },
        "url": "{{base_url}}/api/v1/admin/business-locations/municipalities"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.response.to.have.status(201);",
              "pm.environment.set('municipality_id', pm.response.json().id);"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "5. Verify Province Districts",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{admin_token}}" }
        ],
        "url": "{{base_url}}/api/v1/admin/business-locations/provinces/{{province_id}}/districts"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.response.to.have.status(200);",
              "pm.expect(pm.response.json().length).to.be.greaterThan(0);"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "6. Verify District Municipalities",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{admin_token}}" }
        ],
        "url": "{{base_url}}/api/v1/admin/business-locations/districts/{{district_id}}/municipalities"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.response.to.have.status(200);",
              "pm.expect(pm.response.json().length).to.be.greaterThan(0);"
            ],
            "type": "text/javascript"
          }
        }
      ]
    }
  ]
}
