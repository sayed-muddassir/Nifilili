{
  "info": {
    "_postman_id": "order-collection-001",
    "name": "Order Module - Happy Path",
    "description": "End-to-end happy path for the order module: login -> cart -> checkout -> order -> payment -> status updates -> return -> refund",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {"key": "run_id", "value": "{{$timestamp}}"}
  ],
  "item": [
    {
      "name": "01 - Auth",
      "item": [
        {
          "name": "Login as User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('Has token', () => pm.expect(json.accessToken).to.be.a('string'));",
                  "pm.environment.set('token', json.accessToken);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\"usernameOrEmail\": \"{{user_email}}\", \"password\": \"{{user_password}}\"}"
            },
            "url": "{{base_url}}/api/auth/login"
          }
        },
        {
          "name": "Login as Owner",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.environment.set('owner_token', pm.response.json().accessToken);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\"usernameOrEmail\": \"{{owner_email}}\", \"password\": \"{{owner_password}}\"}"
            },
            "url": "{{base_url}}/api/auth/login"
          }
        },
        {
          "name": "Login as Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.environment.set('admin_token', pm.response.json().accessToken);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\"usernameOrEmail\": \"{{admin_email}}\", \"password\": \"{{admin_password}}\"}"
            },
            "url": "{{base_url}}/api/auth/login"
          }
        }
      ]
    },
    {
      "name": "02 - Cart",
      "item": [
        {
          "name": "Add Item to Cart",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('Has items', () => pm.expect(json.items).to.be.an('array'));",
                  "if (json.items.length > 0) { pm.environment.set('cart_item_id', json.items[0].cartItemId); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{token}}"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"offeringId\": 1, \"quantity\": 2}"
            },
            "url": "{{base_url}}/api/v1/cart/items"
          }
        },
        {
          "name": "Get Cart",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('Has cartId', () => pm.expect(json.cartId).to.be.a('number'));",
                  "pm.test('Has summary', () => pm.expect(json.summary).to.be.an('object'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
            "url": "{{base_url}}/api/v1/cart"
          }
        },
        {
          "name": "Update Cart Item Quantity",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{token}}"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"quantity\": 3}"
            },
            "url": "{{base_url}}/api/v1/cart/items/{{cart_item_id}}"
          }
        }
      ]
    },
    {
      "name": "03 - Checkout",
      "item": [
        {
          "name": "Checkout Preview",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('Has business groups', () => pm.expect(json.businessGroups).to.be.an('array'));",
                  "pm.test('Has summary', () => pm.expect(json.summary).to.be.an('object'));",
                  "pm.test('Has payable amount', () => pm.expect(json.summary.payableAmount).to.be.a('number'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{token}}"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"address\": {\"municipalityId\": 1, \"wardNumber\": 5, \"toleName\": \"Kathmandu\", \"addressField1\": \"123 Main St\"}}"
            },
            "url": "{{base_url}}/api/v1/checkout/preview"
          }
        }
      ]
    },
    {
      "name": "04 - Place Order",
      "item": [
        {
          "name": "Place Order (COD)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "pm.test('Has orderId', () => pm.expect(json.orderId).to.be.a('number'));",
                  "pm.test('Has orderNumber', () => pm.expect(json.orderNumber).to.be.a('string'));",
                  "pm.environment.set('order_id', json.orderId);",
                  "pm.environment.set('order_number', json.orderNumber);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{token}}"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"receiverName\": \"John Doe\", \"contactNumber\": \"9841234567\", \"email\": \"john@example.com\", \"address\": {\"municipalityId\": 1, \"wardNumber\": 5, \"toleName\": \"Kathmandu\", \"addressField1\": \"123 Main St\"}, \"paymentTypeId\": {{payment_type_id}}}"
            },
            "url": "{{base_url}}/api/v1/orders"
          }
        }
      ]
    },
    {
      "name": "05 - Query Orders",
      "item": [
        {
          "name": "List My Orders",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('Has content', () => pm.expect(json.content).to.be.an('array'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
            "url": "{{base_url}}/api/v1/orders"
          }
        },
        {
          "name": "Get Order Details",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('Has orderNumber', () => pm.expect(json.orderNumber).to.be.a('string'));",
                  "pm.test('Has items', () => pm.expect(json.items).to.be.an('array'));",
                  "if (json.items.length > 0) { pm.environment.set('order_item_id', json.items[0].orderItemId); }"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
            "url": "{{base_url}}/api/v1/orders/{{order_id}}"
          }
        }
      ]
    },
    {
      "name": "06 - Business Order Management",
      "item": [
        {
          "name": "Update Item Status to RECEIVED",
          "event": [
            {
              "listen": "test",
              "script": {
